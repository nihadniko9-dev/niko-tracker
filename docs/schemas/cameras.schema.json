{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "niko.cameras/1",
  "title": "Niko Tracker cameras.json",
  "type": "object",
  "required": ["schema", "producer", "clip", "conventions", "distortion_model", "frames"],
  "properties": {
    "schema": {"const": "niko.cameras/1"},
    "producer": {
      "type": "object",
      "required": ["method"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "created": {"type": "string"},
        "notes": {"type": "string"}
      }
    },
    "clip": {
      "type": "object",
      "required": ["width", "height", "fps", "frame_start", "n_frames"],
      "properties": {
        "name": {"type": "string"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "frame_start": {"type": "integer"},
        "n_frames": {"type": "integer", "minimum": 1}
      }
    },
    "conventions": {
      "type": "object",
      "required": ["camera", "extrinsics", "pixel_origin"],
      "properties": {
        "camera": {"const": "opencv"},
        "extrinsics": {"const": "world_to_camera"},
        "pixel_origin": {"const": "corner"},
        "world_up": {"enum": ["+z", "unknown"]},
        "units": {"enum": ["meters", "arbitrary"]}
      }
    },
    "intrinsics_mode": {"enum": ["shared", "per_frame_focal", "per_frame"]},
    "distortion_model": {"const": "opencv5"},
    "rolling_shutter": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["readout", "direction"],
          "properties": {
            "readout": {"type": "number", "minimum": 0, "maximum": 1},
            "direction": {"enum": ["top_to_bottom", "bottom_to_top", "left_to_right", "right_to_left"]}
          }
        }
      ]
    },
    "points": {"type": ["string", "null"]},
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/frame"}
    },
    "extra": {"type": "object"}
  },
  "$defs": {
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "mat3": {"type": "array", "items": {"$ref": "#/$defs/vec3"}, "minItems": 3, "maxItems": 3},
    "frame": {
      "type": "object",
      "required": ["i", "frame", "valid", "K", "dist", "R", "t"],
      "properties": {
        "i": {"type": "integer", "minimum": 0},
        "frame": {"type": "integer"},
        "valid": {"type": "boolean"}
      },
      "if": {"properties": {"valid": {"const": true}}},
      "then": {
        "properties": {
          "K": {"$ref": "#/$defs/mat3"},
          "dist": {"type": "array", "items": {"type": "number"}, "minItems": 5, "maxItems": 5},
          "R": {"$ref": "#/$defs/mat3"},
          "t": {"$ref": "#/$defs/vec3"}
        }
      },
      "else": {
        "properties": {
          "K": {"type": "null"},
          "dist": {"type": "null"},
          "R": {"type": "null"},
          "t": {"type": "null"}
        }
      }
    }
  }
}
